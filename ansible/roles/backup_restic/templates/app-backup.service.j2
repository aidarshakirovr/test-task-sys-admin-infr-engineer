[Unit]
Description=Automated Restic Backup Service
After=network-online.target
Wants=network-online.target
OnFailure=app-backup-failure.service

[Service]
Type=oneshot
User={{ restic_user }}
Group={{ restic_group }}
EnvironmentFile=-{{ restic_aws_env_file }}
Environment=BACKUP_SOURCE={{ backup_source_dir }}
Environment=RESTIC_CACHE_DIR={{ restic_cache_dir }}
Environment=RESTIC_PASSWORD_FILE={{ restic_password_file }}
Environment=RESTIC_REPOSITORY={{ restic_repo_path }}
{% if restic_copy_enabled | bool %}
Environment=RESTIC_SECONDARY_REPOSITORY={{ restic_secondary_repo_path }}
Environment=RESTIC_SECONDARY_PASSWORD_FILE={{ restic_secondary_password_file }}
{% endif %}
ExecStart=/usr/local/bin/backup-app.sh
Nice={{ restic_nice_level }}
IOSchedulingClass={{ restic_ionice_class }}
IOSchedulingPriority={{ restic_ionice_level }}
# Avoid recursive ACL on ~100GB trees; allow reading any readable-by-DAC path.
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{ restic_local_repo_path if restic_backend == "local" else restic_cache_dir }} {{ restic_cache_dir }}
ReadOnlyPaths={{ backup_source_dir }} {{ restic_password_file }}{% if restic_copy_enabled | bool %} {{ restic_secondary_password_file }}{% endif %}
{% if restic_backend == "s3" or (restic_copy_enabled | bool and restic_secondary_backend == "s3") %}
ReadOnlyPaths={{ restic_aws_env_file }}
{% endif %}

