[Unit]
Description=Automated Restic Backup Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ restic_user }}
Group={{ restic_group }}
ExecStart=/usr/local/bin/backup-app.sh
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{ restic_repo_path }} /tmp
ReadOnlyPaths={{ backup_source_dir }} {{ restic_password_file }}
