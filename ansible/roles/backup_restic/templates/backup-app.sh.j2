#!/usr/bin/env bash
set -Eeuo pipefail

RESTIC_REPOSITORY="${RESTIC_REPOSITORY:-{{ restic_repo_path }}}"
RESTIC_PASSWORD_FILE="${RESTIC_PASSWORD_FILE:-{{ restic_password_file }}}"
RESTIC_CACHE_DIR="${RESTIC_CACHE_DIR:-{{ restic_cache_dir }}}"
BACKUP_SOURCE="${BACKUP_SOURCE:-{{ backup_source_dir }}}"
{% if restic_pre_backup_hook | length > 0 %}
PRE_BACKUP_HOOK="{{ restic_pre_backup_hook }}"
{% endif %}
{% if restic_copy_enabled | bool %}
RESTIC_SECONDARY_REPOSITORY="${RESTIC_SECONDARY_REPOSITORY:-{{ restic_secondary_repo_path }}}"
RESTIC_SECONDARY_PASSWORD_FILE="${RESTIC_SECONDARY_PASSWORD_FILE:-{{ restic_secondary_password_file }}}"
{% endif %}
{% if restic_healthcheck_url | length > 0 %}
HEALTHCHECK_URL="{{ restic_healthcheck_url }}"
{% endif %}

export RESTIC_CACHE_DIR

failure_handler() {
    local lineno="$1"
    local exit_code="$2"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] Backup failed at line ${lineno} with exit status ${exit_code}." >&2
    exit "${exit_code}"
}

trap 'failure_handler "$LINENO" "$?"' ERR

{% if restic_pre_backup_hook | length > 0 %}
if [[ -x "${PRE_BACKUP_HOOK}" ]]; then
  echo "[INFO] Running pre-backup hook ${PRE_BACKUP_HOOK} (DB dump / FS snapshot)..."
  "${PRE_BACKUP_HOOK}"
else
  echo "[ERROR] restic_pre_backup_hook is set but not executable: ${PRE_BACKUP_HOOK}" >&2
  exit 1
fi
{% else %}
# If /srv/app/data holds a live DB, set restic_pre_backup_hook to a dump/snapshot script.
{% endif %}

{% if restic_no_lock | bool %}
# WARNING: restic_no_lock=true — repository locking disabled.
NO_LOCK_ARGS=(--no-lock)
{% else %}
NO_LOCK_ARGS=()
{% endif %}

echo "[INFO] Starting restic backup of ${BACKUP_SOURCE}..."
restic backup \
    "${NO_LOCK_ARGS[@]}" \
    --repo "${RESTIC_REPOSITORY}" \
    --password-file "${RESTIC_PASSWORD_FILE}" \
    --tag "app-data" \
{% for exclude in restic_excludes %}
    --exclude "{{ exclude }}" \
{% endfor %}
    "${BACKUP_SOURCE}"

{% if restic_copy_enabled | bool %}
echo "[INFO] Copying new snapshots to secondary (offsite) repository..."
restic copy \
    "${NO_LOCK_ARGS[@]}" \
    --repo "${RESTIC_SECONDARY_REPOSITORY}" \
    --password-file "${RESTIC_SECONDARY_PASSWORD_FILE}" \
    --from-repo "${RESTIC_REPOSITORY}" \
    --from-password-file "${RESTIC_PASSWORD_FILE}"
{% endif %}

{% if restic_healthcheck_url | length > 0 %}
if command -v curl >/dev/null 2>&1; then
  curl -fsS -m 10 --retry 2 "${HEALTHCHECK_URL}" >/dev/null || true
fi
{% endif %}

echo "[INFO] Backup completed successfully. Retention/prune is NOT run on this host."
echo "[INFO] Apply forget/prune from a separate admin host (ansible/playbooks/backup-retention.yml)."
