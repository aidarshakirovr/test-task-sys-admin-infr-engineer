[Unit]
Description=Weekly Restic repository integrity check
After=network-online.target
Wants=network-online.target
OnFailure=app-backup-failure.service

[Service]
Type=oneshot
User={{ restic_user }}
Group={{ restic_group }}
EnvironmentFile=-{{ restic_aws_env_file }}
Environment=RESTIC_CACHE_DIR={{ restic_cache_dir }}
Environment=RESTIC_PASSWORD_FILE={{ restic_password_file }}
Environment=RESTIC_REPOSITORY={{ restic_repo_path }}
ExecStart=/usr/local/bin/restic-check.sh
Nice={{ restic_nice_level }}
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{ restic_cache_dir }}{% if restic_backend == "local" %} {{ restic_local_repo_path }}{% endif %}
ReadOnlyPaths={{ restic_password_file }}
